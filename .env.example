# Database
DATABASE_PATH=./bugbase.db

# JWT Secret (change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this

# ImgBB API Key (get from https://api.imgbb.com/)
IMGBB_API_KEY=

# FreeImage.host API Key (fallback for ImgBB)
FREEIMAGE_API_KEY=

# MCP Server (internal self-fetch origin for containerized deployments)
INTERNAL_ORIGIN=http://localhost:3000

# Local LLM Service
LOCAL_LLM_URL=http://localhost:3010/v1/chat/completions
LOCAL_LLM_MODEL=
LOCAL_LLM_CLIENT_KEY=
